# Created by https://www.toptal.com/developers/gitignore/api/android,gradle,kotlin

### Android ###
# Built application files
*.apk
*.aab
*.ap_

# Files for the Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (SDK path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log files
*.log

# Android Studio Navigation editor files
.navigation/

# Android Studio captures folder
captures/

# Keystore files
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild/

# Google Services (e.g., Firebase) config file
google-services.json

### Gradle ###
.gradletasknamecache
gradle-app.setting

# Ignore Gradle GUI config
gradle-wrapper.properties

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignoring Gradle wrapper properties
!gradlew
!gradlew.bat

# Lock file
gradle.lockfile

### IntelliJ ###
# Covers .idea/ and any *.iml files
.idea/
*.iml
*.ipr
*.iws
out/
com_crashlytics_export_strings.xml
crashlytics.properties
crashlytics-build.properties
fabric.properties

### Kotlin ###
# Compiled class files
*.class

# Compiled sketch files
*.sk

# Compiled script files
*.kts

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Log files
*.log

# Other
.DS_Store