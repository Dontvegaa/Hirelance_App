<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="12dp"
    app:cardBackgroundColor="@color/hl_fondo_tarjeta"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imgFotoEstudiante"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_menu_perfil"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textNombreEstudiante"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="@color/hl_texto_principal"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/imgFotoEstudiante"
            app:layout_constraintTop_toTopOf="@+id/imgFotoEstudiante"
            tools:text="Juan Pérez" />

        <TextView
            android:id="@+id/textCarreraEstudiante"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="@color/hl_acento_naranja"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/imgFotoEstudiante"
            app:layout_constraintTop_toBottomOf="@+id/textNombreEstudiante"
            tools:text="Ingeniería en Sistemas" />

        <TextView
            android:id="@+id/textHabilidadPrincipal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/tag_fondo_azul"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/hl_texto_principal"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@+id/imgFotoEstudiante"
            app:layout_constraintTop_toBottomOf="@+id/textCarreraEstudiante"
            tools:text="Desarrollo Web" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>