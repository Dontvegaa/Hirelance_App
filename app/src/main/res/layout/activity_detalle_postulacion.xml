<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hl_fondo_principal"
    tools:context=".controlador.DetallePostulacionActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarDetallePostulacion"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/hl_fondo_tarjeta"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Detalle de Postulación"
            app:titleTextColor="@color/hl_texto_principal" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textTituloProyecto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hl_texto_principal"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="App Móvil para Restaurante" />

            <TextView
                android:id="@+id/textNombreContratista"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hl_texto_secundario"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                tools:text="Publicado por: Carlos López" />

            <TextView
                android:id="@+id/textEstadoPostulacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/tag_fondo_azul"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/hl_acento_naranja"
                tools:text="Pendiente" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/hl_borde" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tu Propuesta"
                android:textColor="@color/hl_texto_principal"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textPropuestaContenido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/hl_texto_secundario"
                android:textSize="15sp"
                tools:text="Tengo experiencia en el desarrollo de apps con Android Nativo y Firebase..." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tu Oferta"
                        android:textColor="@color/hl_texto_secundario"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/textMontoOfertado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/hl_acento_naranja"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="$243.00" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tiempo Estimado"
                        android:textColor="@color/hl_texto_secundario"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/textTiempoEstimado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/hl_texto_principal"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="2 semanas" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Fecha de Postulación"
                android:textColor="@color/hl_texto_secundario"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/textFechaPostulacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hl_texto_principal"
                android:textSize="14sp"
                tools:text="11 de Noviembre, 2025" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBarDetallePostulacion"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/hl_acento_naranja"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayout"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>