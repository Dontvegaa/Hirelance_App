<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hirelance"

        android:usesCleartextTraffic="true">

        <activity
            android:name="com.hirelance.controlador.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".controlador.PerfilEstudianteActivity"
            android:exported="false" />

        <activity
            android:name=".controlador.EditarPerfilActivity"
            android:exported="false" />

        <activity
            android:name=".controlador.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".controlador.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".controlador.DetalleProyectoActivity"
            android:exported="false" />

        <activity
            android:name=".controlador.MisPostulacionesActivity"
            android:exported="false" />

        <activity
            android:name=".controlador.PostulacionActivity"
            android:exported="false" />

        <activity
            android:name=".controlador.DetallePostulacionActivity"
            android:exported="false" />

        <activity
            android:name=".controlador.ContratistaDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".controlador.VerPostulacionesActivity"
            android:exported="false" />

        <activity
            android:name=".controlador.DetallePostulanteActivity"
            android:exported="false" />

        <activity
            android:name=".controlador.PublicarProyectoActivity"
            android:exported="false" />


    </application>

</manifest>